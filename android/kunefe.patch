+    /**
+     * Künefe: APK içindeki paketi (1.21.11 + Fabric + modlar) ilk açılışta kendiliğinden kurar.
+     */
+    private fun autoImportKunefePack() {
+        val prefs = getSharedPreferences("kunefe", MODE_PRIVATE)
+        if (prefs.getBoolean("pack_imported", false)) return
+        lifecycleScope.launch {
+            val file = withContext(Dispatchers.IO) {
+                runCatching {
+                    val out = File(cacheDir, "kunefe_auto.mrpack")
+                    assets.open("kunefe.mrpack").use { input -> out.outputStream().use { input.copyTo(it) } }
+                    out
+                }.getOrNull()
+            } ?: return@launch
+            modpackImportViewModel.import(
+                context = this@MainActivity,
+                uri = Uri.fromFile(file),
+                onStop = {
+                    if (modpackImportViewModel.importOperation is ModpackImportOperation.Finished) {
+                        prefs.edit().putBoolean("pack_imported", true).apply()
+                    }
+                }
+            )
+        }
+    }
